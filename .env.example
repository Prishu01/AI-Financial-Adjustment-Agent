# -------------------------------------------------------
# AI Financial Adjustment Agent — Environment Variables
# -------------------------------------------------------
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# LLM Provider: "openai", "gemini", or "none" (deterministic fallback only)
LLM_PROVIDER=none

# OpenAI API Key (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Key (required if LLM_PROVIDER=gemini)
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Data and output directories (defaults shown)
DATA_DIR=data
OUTPUT_DIR=output
